# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files - NEVER commit these!
.env
.env*.local
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/

# OS
Thumbs.db

# Logs
logs
*.log

# Schema diffs and SQL exports (generated files)
*.sql
*.diff
/prisma/schemas/*.sql
/prisma/schemas/*.diff

# Prisma migrations must be committed
!/prisma/migrations/**/migration.sql

# Database scratch files
scratch-*.db

# One-off logs and output files
*-output.log
*-output.txt
lint-output*.txt

# But include source code in logs folders
!app/**/logs/
!app/**/logs/**

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Prisma
# Exclude database files to avoid overwriting production data
prisma/dev.db
prisma/*.db
prisma/*.db-journal
prisma/*.db.backup*

# PM2
ecosystem.config.js

# Uploads - runtime files live outside the repo (UPLOADS_DIR, or ./uploads in dev).
# Serving user documents from public/ would bypass the API authorization layer,
# so neither location may be committed.
/uploads/*
!/uploads/.gitkeep
/public/uploads/
/public/uploads/*

# Backups - local development backups
/backups
/backups/*

# Test Results - generated output, never commit
/test-results.json
/data/test-results/*.json

# JSON Data Imports - Generated by scraping tools
/data/json-imports/
/data/journal/seed-bundles/
/data/journal/cache/
*.json.backup

# NOTE: __tests__/fixtures/ is intentionally NOT ignored.
# test-image.jpg is a committed fixture and future fixtures must stay committable.

# ---------------------------------------------------------------------------
# NEVER PUBLISH - real member data, credentials, artifacts
# Also excluded from the public tree by scripts/publish/public-exclude.txt.
# ---------------------------------------------------------------------------
/data/users.json
/data/member-register-*.csv
/data/member-register-*.ods
/data/ascends.csv
/data/climbers.csv
/data/user-identifier-audit-*.json
/data/git-commits/
/scripts/migration/bwb-members-export.json
/scripts/migration/user-profiles-template.csv
/scripts/seed/fixtures/
/scripts/seed/json-data/users.json
/data-tools-archive/
/temp/
/uploads/
/.git-backup-info
