# BWB Climbing App - Environment Variables
# Copy this file to .env.local for local development (Next.js reads it first).
# Docker Compose and PM2 read .env, so create that one on a server as well.
# See SETUP.md section 1.3 for the precedence rules.

# =============================================================================
# REQUIRED - Authentication
# =============================================================================

# NextAuth.js secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-change-this-in-production

# Public URL of your application
# Development: http://localhost:1345
# Production: https://bwb.example.com
NEXTAUTH_URL=http://localhost:1345

# =============================================================================
# REQUIRED - Database
# =============================================================================

# SQLite database path. Relative paths resolve against the repository root
# (src/lib/prisma.ts and scripts/shared/prisma-client.js both join with cwd).
# Development: file:./prisma/dev.db  -> <repo-root>/prisma/dev.db
# Production (PM2): an absolute path, e.g. file:/srv/bwb/data/bwb.db
# Production Docker: file:/app/data/bwb.db (set by the image, mapped via volume)
DATABASE_URL="file:./prisma/dev.db"

# =============================================================================
# OPTIONAL - Storage Paths
# =============================================================================

# Directory for uploaded files (change-requests, consent-types, documents,
# user-consents, support-requests, notes, meister-reports, journal, sponsors)
# Development: leave unset -> defaults to <repo-root>/uploads (NOT public/uploads)
# Production: REQUIRED. getUploadsBaseDir() throws if this is unset while
#             NODE_ENV=production, because a public/ fallback would bypass the
#             API-level authorization checks on /api/uploads/[...path].
# Production Docker: /app/uploads (set by docker-compose)
# UPLOADS_DIR=/app/uploads

# Directory for database and file backups
# All consumers (backup list/download API and the health check) resolve this
# through getBackupDir() in src/lib/constants.ts, so they can never disagree.
# Development: leave unset -> <repo-root>/backups
# Production: leave unset -> /app/backups (the Docker volume mount point)
# Production Docker: /app/backups (set by docker-compose)
# BACKUP_DIR=/app/backups

# =============================================================================
# OPTIONAL - Backup Security
# =============================================================================

# Password for encrypting backup archives (recommended: 20+ characters)
# If not set, backups will use a default password (not recommended for production)
# BACKUP_PASSWORD="your-secure-20char-password-here"

# =============================================================================
# REQUIRED - Cloudflare Turnstile (Bot Protection)
# =============================================================================

# Turnstile Site Key (visible on client-side, prefix with NEXT_PUBLIC_)
# Get your keys from: https://dash.cloudflare.com/?to=/:account/turnstile
# Development: Use test key 1x00000000000000000000AA (always passes)
# Production: Use your real sitekey from Cloudflare dashboard
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Turnstile Secret Key (server-side only, keep secret!)
# Development: Use test key 1x0000000000000000000000000000000AA (always validates)
# Production: Use your real secret key from Cloudflare dashboard
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# =============================================================================
# OPTIONAL - Email Service (Brevo)
# =============================================================================

# Brevo API key for sending emails (verification, password reset, etc.)
# Get your key at: https://app.brevo.com/settings/keys/api
# BREVO_API_KEY=xkeysib-...

# Email sender address (must be verified in Brevo)
# BREVO_SENDER_EMAIL=no-reply@example.com

# Email sender name
# BREVO_SENDER_NAME="BWB Team"

# Public URL of your application (used in email links)
# Development: http://localhost:1345
# Production: https://bwb.example.com
# APP_URL=http://localhost:1345

# Development email override (routes all emails to this address in dev mode)
# Only used when NODE_ENV=development
# DEV_EMAIL_RECIPIENT=developer@example.com

# Recipient for support notifications when no support clerk is configured.
# Falls back to BREVO_SENDER_EMAIL, then to no-reply@example.com
# SUPPORT_FALLBACK_EMAIL=support@example.com

# =============================================================================
# OPTIONAL - Server Configuration
# =============================================================================

# Node environment (development, production, test)
NODE_ENV=development

# Port the application listens on (default: 1345)
PORT=1345

# =============================================================================
# OPTIONAL - AI Integration
# =============================================================================

# OpenAI API key for git commit to change request sync
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# =============================================================================
# OPTIONAL - Git integration
# =============================================================================

# Site identity shown to visitors. All three are optional.
#   NEXT_PUBLIC_SITE_NAME   - the site name in page titles, the app manifest,
#                             email headers and the footer. Defaults to
#                             "Peak-bagging Community". Never defaults to the
#                             original project's name.
#   NEXT_PUBLIC_OPERATOR_NAME - shown as "Operated by <name>" beside the
#                             copyright notice. Omitted when unset.
#   NEXT_PUBLIC_SOURCE_URL  - your own Corresponding Source. AGPL-3.0 section 13
#                             requires anyone running a modified version as a
#                             network service to offer its source to its users,
#                             so set this on a public deployment. Omitted when
#                             unset.
# NEXT_PUBLIC_SITE_NAME=Peak-bagging Community
# NEXT_PUBLIC_OPERATOR_NAME=Your Name or Organisation
# NEXT_PUBLIC_SOURCE_URL=https://example.com/your/source

# External links are NOT environment variables. They live in src/config/site.ts
# under EXTERNAL_LINKS, are empty by default, and are rendered only when set:
#   home, news, hallOfFame, manual, journalArchive, resources, socialMedia,
#   eTalks, membersSurvey, about, contact, terms, privacy
# Anything left empty is simply not shown, so a deployment never links to a site
# its operator does not control.

# GitHub repository (owner/name). Two uses:
#   1. GITHUB_REPO / NEXT_PUBLIC_GITHUB_REPO build commit deep links in the
#      change-request UI. Leave unset to render commit hashes as plain text.
#   2. NEXT_PUBLIC_GITHUB_REPO also renders the "Source code" link in the public
#      footer. AGPL-3.0 section 13 requires that users interacting with this
#      program over a network are offered its Corresponding Source, so set this
#      on any public deployment.
# GITHUB_REPO=your-org/your-repo
# NEXT_PUBLIC_GITHUB_REPO=your-org/your-repo

# =============================================================================
# OPTIONAL - Build and tooling
# =============================================================================

# Base URL used by the admin roles page for its API calls
# Defaults to http://localhost:3100 when unset
# NEXT_PUBLIC_API_URL=http://localhost:1345

# Set to "true" to make `next build` ignore TypeScript errors.
# Intended for emergency local builds only - never enable it for a release.
# SKIP_TYPE_CHECK=false

# Commit message passed to the versioning hook (scripts/versioning/)
# BWB_COMMIT_MSG=

# =============================================================================
# OPTIONAL - Demo data
# =============================================================================

# Password for the synthetic demo users created by `npm run db:seed`.
# If unset, a random password is generated and printed once.
# Ignored entirely when NODE_ENV=production.
# DEMO_USER_PASSWORD=

# =============================================================================
# REQUIRED - Stripe Payment Processing
# =============================================================================

# Stripe Secret Key (server-side only, keep secret!)
# Test Mode: Get from https://dashboard.stripe.com/test/apikeys
# Live Mode: Get from https://dashboard.stripe.com/apikeys
# Test keys start with: sk_test_
# Live keys start with: sk_live_
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Publishable Key (client-side, safe to expose)
#
# NOT CURRENTLY USED. Donations run through Stripe Checkout: the server creates
# a session in /api/donations/checkout and the browser is redirected to the
# hosted Stripe page, so no Stripe.js / client-side key is loaded. Kept here so
# that adding Stripe Elements later has an obvious place to read it from.
# Test Mode: Get from https://dashboard.stripe.com/test/apikeys
# Live Mode: Get from https://dashboard.stripe.com/apikeys
# Test keys start with: pk_test_
# Live keys start with: pk_live_
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook Secret (for verifying webhook signatures)
# Get from: https://dashboard.stripe.com/webhooks after creating endpoint
# Local Development: Use Stripe CLI: stripe listen --forward-to localhost:1345/api/donations/webhook
# Production: Create webhook endpoint at https://yourdomain.com/api/donations/webhook
# Listen for events: checkout.session.completed, checkout.session.expired
# Keys start with: whsec_
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
