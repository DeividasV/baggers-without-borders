{
  "name": "bwb-climbing-app",
  "version": "0.1218.0",
  "license": "AGPL-3.0-only",
  "author": "Deividas Valaitis",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "predev": "node scripts/dev/ensure-node-24.js",
    "dev": "next dev -p 1345",
    "prebuild": "node scripts/dev/ensure-node-24.js",
    "build": "next build",
    "prestart": "node scripts/dev/ensure-node-24.js",
    "start": "next start -p 1345",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "lint:staged": "lint-staged",
    "type-check": "tsc --noEmit --skipLibCheck",
    "check:all": "chmod +x scripts/check-all.sh && ./scripts/check-all.sh",
    "security:secrets": "node scripts/security/scan-secrets.js",
    "sbom": "npm sbom --sbom-format=cyclonedx",
    "pretest": "node scripts/dev/ensure-node-24.js",
    "test": "npm run test:critical",
    "test:critical": "npm run test:unit && npm run test:api && npm run test:contracts && npm run test:e2e && npm run test:integration && npm run test:results",
    "test:results": "jest --json --outputFile=data/test-results/test-results.json",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ui": "jest --watch --verbose",
    "test:integration": "jest --config=jest.integration.config.js --forceExit",
    "test:integration:watch": "jest --config=jest.integration.config.js --watch",
    "test:unit": "jest --testPathPatterns=__tests__/unit --forceExit",
    "test:api": "jest --runInBand --testPathPatterns=__tests__/api --forceExit",
    "test:components": "jest --testPathPatterns=__tests__/components",
    "test:a11y": "jest --testPathPatterns=__tests__/a11y",
    "test:a11y:watch": "jest --testPathPatterns=__tests__/a11y --watch",
    "test:e2e": "jest --config=jest.e2e.config.js --runInBand --forceExit",
    "test:e2e:watch": "jest --config=jest.e2e.config.js --watch",
    "test:contracts": "jest --config=jest.contracts.config.js --runInBand --forceExit",
    "test:contracts:watch": "jest --config=jest.contracts.config.js --watch",
    "test:all": "npm run test:unit && npm run test:api && npm run test:contracts && npm run test:e2e && npm run test:integration && npm run test:components && npm run test:a11y",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:seed-users": "node scripts/seed/seed-users.js",
    "db:seed-hof-entries": "node scripts/seed/seed-hof-entries.js",
    "db:delete-all": "node scripts/data/delete-all-data.js",
    "db:delete-all:dry": "node scripts/data/delete-all-data.js --dry-run",
    "db:reset-password": "node scripts/admin/reset-password.js",
    "db:studio": "prisma studio",
    "db:export-members": "node scripts/data/export-members-csv.js",
    "db:cleanup-logs": "node scripts/admin/cleanup-audit-logs.js",
    "db:cleanup-rate-limits": "node scripts/admin/cleanup-rate-limits.js",
    "db:pull": "./scripts/deployment/pull-db.sh",
    "db:pull:restore": "./scripts/deployment/pull-db.sh --restore",
    "db:pull:compare": "./scripts/deployment/pull-db.sh --compare",
    "db:pull:schema": "./scripts/deployment/pull-db.sh --schema",
    "icons:generate": "node scripts/dev/generate-icons.js",
    "version:calculate": "node scripts/versioning/calculate-version.js",
    "version:update": "node scripts/versioning/update-version.js",
    "version:setup": "chmod +x scripts/versioning/setup-auto-versioning.sh && ./scripts/versioning/setup-auto-versioning.sh",
    "commit:suggest": "node scripts/versioning/suggest-commit.js",
    "commit": "node scripts/versioning/interactive-commit.js",
    "commit:all": "node scripts/versioning/commit-everything.js",
    "deploy": "chmod +x scripts/deployment/deploy.sh && ./scripts/deployment/deploy.sh",
    "restart-prod": "ssh root@example.com 'pm2 restart bwb-climbing'"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.0.4",
    "@prisma/adapter-better-sqlite3": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/config": "^7.2.0",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "^7.0.1",
    "archiver-zip-encrypted": "^2.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.562.0",
    "next": "^16.1.1",
    "next-auth": "^4.24.5",
    "openai": "^6.15.0",
    "prisma": "^7.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "stripe": "^20.3.0",
    "uuid": "^13.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.3.2",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=10.0.0 <12.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "overrides": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  }
}
